+ #  define secure_getenv(name) \
+         (issetugid() ? NULL : getenv(name))
+ #  undef HAVE_SECURE_GETENV
+ #  define HAVE_SECURE_GETENV 1
+ #endif // HAVE_[__]SECURE_GETENV
++#else
++#define secure_getenv(name) getenv(name)
++#undef  HAVE_SECURE_GETENV
++#define HAVE_SECURE_GETENV 1
++#endif
