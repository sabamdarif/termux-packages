diff --git a/x11-packages/consolekit2/0001-missing-macros.patch b/x11-packages/consolekit2/0001-missing-macros.patch
new file mode 100644
index 00000000000000..eec9961c9b9c68
--- /dev/null
+++ b/x11-packages/consolekit2/0001-missing-macros.patch
@@ -0,0 +1,14 @@
+--- a/src/ck-session.c
++++ b/src/ck-session.c
+@@ -1591,9 +1591,11 @@
+                         g_warning ("failed to return control of vt handling");
+                 }
+ 
++#if defined(KDSETMODE) && defined(KD_TEXT)
+                 if (ioctl (session->priv->tty_fd, KDSETMODE, KD_TEXT) < 0) {
+                         g_warning ("failed to return to text mode for the VT");
