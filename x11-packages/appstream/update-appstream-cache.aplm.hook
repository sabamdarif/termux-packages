
# based on https://gitlab.archlinux.org/archlinux/packaging/packages/appstream/-/blob/f708a15d295cfb0b14d9d626bffbd1e0878054f3/update-appstream-cache.hook
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = @TERMUX_PREFIX_TARGET@/share/app-info/*
Target = @TERMUX_PREFIX_TARGET@/share/swcatalog/*

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = appstream

[Action]
Description = Updating the appstream cache...
When = PostTransaction
Exec = @TERMUX_PREFIX@/bin/appstreamcli refresh-cache --force
