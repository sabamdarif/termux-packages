+
+#include "terpkgindex.h"
+
+#include "../../logging.h"
+
+namespace ASGenerator
+{
+
+TermuxPackageIndex::TermuxPackageIndex(const std::string &dir)
+    : DebianPackageIndex(dir)
+{
+}
+
+std::shared_ptr<DebPackage> TermuxPackageIndex::newPackage(
+    const std::string &name,
+    const std::string &ver,
+    const std::string &arch)
+{
+    auto termuxPkg = std::make_shared<TermuxPackage>(name, ver, arch);
+    return std::static_pointer_cast<DebPackage>(termuxPkg);
+}
+
+std::string TermuxPackageIndex::dataPrefix() const
+{
+    return "/data/data/com.termux/files/usr";
+}
+
+} // namespace ASGenerator
