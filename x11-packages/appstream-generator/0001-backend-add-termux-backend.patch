+#include "terpkg.h"
+
+#include "../../config.h"
+#include "../../logging.h"
+#include "../../zarchive.h"
+#include "../../utils.h"
+
+namespace ASGenerator
+{
+
+TermuxPackage::TermuxPackage(
+    const std::string &pname,
+    const std::string &pver,
+    const std::string &parch,
+    std::shared_ptr<DebPackageLocaleTexts> l10nTexts)
+    : DebPackage(pname, pver, parch, std::move(l10nTexts)),
+      m_contentsRead(false),
+      m_dataArchive(std::make_unique<ArchiveDecompressor>())
+{
+    termuxUpdateTmpDirPath();
+}
+
+TermuxPackage::~TermuxPackage()
+{
+    termuxFinish();
+}
+
+void TermuxPackage::termuxUpdateTmpDirPath()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const auto &conf = Config::get();
+    m_tmpDir = conf.getTmpDir() / std::format("termux-{}-{}_{}", name(), ver(), arch());
+}
+
+ArchiveDecompressor &TermuxPackage::openPayloadArchive()
+{
+    if (m_dataArchive->isOpen())
+        return *m_dataArchive;
+
+    ArchiveDecompressor ad;
+    // extract the payload to a temporary location first
+    ad.open(getFilename());
+    fs::create_directories(m_tmpDir);
+
+    const std::regex dataRegex(R"(data\.*)");
+    auto files = ad.extractFilesByRegex(dataRegex, m_tmpDir);
+    if (files.empty()) {
+        throw std::runtime_error(
+            std::format("Unable to find the payload tarball in Termux package: {}", getFilename()));
+    }
+    const std::string dataArchiveFname = files[0];
+
+    m_dataArchive->open(dataArchiveFname, m_tmpDir / "data");
+    m_dataArchive->setOptimizeRepeatedReads(true);
+    return *m_dataArchive;
+}
+
+const std::vector<std::string> &TermuxPackage::contents()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_contentsRead)
+        return m_contentsL;
+
+    auto &pa = openPayloadArchive();
+    m_contentsL = pa.readContents();
+    m_contentsRead = true;
+    return m_contentsL;
+}
+
+void TermuxPackage::termuxCleanupTemp()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+
+    if (m_dataArchive->isOpen())
+        m_dataArchive->close();
+
+    if (m_tmpDir.empty())
+        return;
+
+    try {
+        if (fs::exists(m_tmpDir)) {
+            fs::remove_all(m_tmpDir);
+        }
+    } catch (const std::exception &e) {
+        // we ignore any error
+        logWarning("Unable to remove temporary directory: {} ({})", m_tmpDir.string(), e.what());
+    }
+}
+
+void TermuxPackage::termuxFinish()
+{
+    termuxCleanupTemp();
+}
+
+} // namespace ASGenerator
