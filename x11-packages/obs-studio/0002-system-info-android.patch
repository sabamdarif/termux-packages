 std::optional<std::vector<GoLiveApi::Gpu>> system_gpu_data()
 {
+#ifdef __ANDROID__
+	std::vector<GoLiveApi::Gpu> adapter_info;
+	GoLiveApi::Gpu gpu{};
+
+	obs_enter_graphics();
+	const char *renderer = gs_get_renderer();
+	const char *driver_ver = gs_get_driver_version();
+
+	gpu.dedicated_video_memory = (uint64_t)gs_get_gpu_dmem() * 1024 * 1024;
+	gpu.shared_system_memory = (uint64_t)gs_get_gpu_smem() * 1024 * 1024;
+	obs_leave_graphics();
+
+	gpu.vendor_id = 0; // Blocked by SELinux on Android
+	gpu.device_id = 0;
+	gpu.model = renderer && *renderer ? renderer : "Unknown Android GPU";
+	gpu.driver_version = driver_ver ? driver_ver : "Unknown Android Driver";
+
+	adapter_info.push_back(gpu);
+	return adapter_info;
