From d5ad46fb4e6752d3d8f511f73af0ffcaad2bb22a Mon Sep 17 00:00:00 2001
From: Md Arif <111168803+sabamdarif@users.noreply.github.com>
Date: Fri, 25 Jul 2025 14:06:24 +0530
Subject: [PATCH] remove polkit from all meson build files

---
 meson.build                     |  9 ---------
 panels/common/meson.build       | 10 +---------
 panels/privacy/meson.build      |  1 -
 panels/sharing/meson.build      |  1 -
 panels/system/meson.build       |  1 -
 panels/system/users/meson.build |  9 ---------
 6 files changed, 1 insertion(+), 30 deletions(-)

diff --git a/meson.build b/meson.build
index c117727..e157798 100644
--- a/meson.build
+++ b/meson.build
@@ -222,15 +222,6 @@ common_deps = [
   gtk_dep,
 ]
 
-polkit_gobject_dep = dependency('polkit-gobject-1', version: '>= 0.103')
-# Also verify that polkit ITS files exist:
-# https://gitlab.gnome.org/GNOME/gnome-control-center/-/issues/491
-polkit_files = [ 'gettext/its/polkit.its', 'gettext/its/polkit.loc' ]
-foreach polkit_file: polkit_files
-  r = run_command('build-aux/meson/find_xdg_file.py', polkit_file, check: true)
-  assert(r.returncode() == 0, 'ITS support missing from polkit, please upgrade or contact your distribution')
-endforeach
-
 # Localisation API
 if cc.has_header_symbol('langinfo.h', '_NL_TIME_FIRST_WEEKDAY')
   config_h.set('HAVE__NL_TIME_FIRST_WEEKDAY', 1,
diff --git a/panels/common/meson.build b/panels/common/meson.build
index 3928de9..f725558 100644
--- a/panels/common/meson.build
+++ b/panels/common/meson.build
@@ -33,7 +33,7 @@ libwidgets = static_library(
   'widgets',
   sources: sources,
   include_directories: top_inc,
-  dependencies: common_deps + [ generates_sources_dep, polkit_gobject_dep ]
+  dependencies: common_deps + [ generates_sources_dep ]
 )
 libwidgets_dep = declare_dependency(
   include_directories: common_inc,
@@ -105,11 +105,3 @@ libdevice_dep = declare_dependency(
   link_with: libdevice
 )
 
-polkit_conf = configuration_data()
-polkit_conf.set('PRIVILEGED_GROUP', get_option('privileged_group'))
-configure_file(
-  input: 'gnome-control-center.rules.in',
-  output: 'gnome-control-center.rules',
-  configuration: polkit_conf,
-  install_dir: join_paths(control_center_datadir, 'polkit-1', 'rules.d')
-)
diff --git a/panels/privacy/meson.build b/panels/privacy/meson.build
index 269b7d2..7809fb4 100644
--- a/panels/privacy/meson.build
+++ b/panels/privacy/meson.build
@@ -44,7 +44,6 @@ deps = common_deps + [
 ]
 
 deps = deps + [
-  polkit_gobject_dep,
   m_dep,
 ]
 
diff --git a/panels/sharing/meson.build b/panels/sharing/meson.build
index bab2588..cc7ba33 100644
--- a/panels/sharing/meson.build
+++ b/panels/sharing/meson.build
@@ -45,7 +45,6 @@ panels_libs += static_library(
   include_directories: [ top_inc, common_inc ],
   dependencies: [
     common_deps,
-    polkit_gobject_dep,
   ],
   c_args: cflags
 )
diff --git a/panels/system/meson.build b/panels/system/meson.build
index 6abb100..11cb9ac 100644
--- a/panels/system/meson.build
+++ b/panels/system/meson.build
@@ -71,7 +71,6 @@ deps = common_deps + [
   liblanguage_dep,
   libsecret_dep,
   krb_dep,
-  polkit_gobject_dep,
 ]
 
 if enable_ibus
diff --git a/panels/system/users/meson.build b/panels/system/users/meson.build
index 5fda2ed..e7173fa 100644
--- a/panels/system/users/meson.build
+++ b/panels/system/users/meson.build
@@ -33,15 +33,6 @@ install_data(
   install_dir: image_dir
 )
 
-polkit = 'org.gnome.controlcenter.user-accounts.policy'
-i18n.merge_file(
-  input: polkit + '.in',
-  output: polkit,
-  po_dir: po_dir,
-  install: true,
-  install_dir: join_paths(control_center_datadir, 'polkit-1', 'actions')
-)
-
 realmd_namespace = 'org.freedesktop.realmd'
 sources += gnome.gdbus_codegen(
   'cc-realm-generated',
-- 
2.48.1

