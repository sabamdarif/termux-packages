-	gint i;
-
-	for (i = 0; i < G_N_ELEMENTS (udev_ids); i++) {
-		if (g_udev_device_get_property_as_boolean (device, udev_ids[i]))
-			type |= (1 << i);
-	}
+	
+	/* In Termux, we have limited hardware detection capabilities
+	 * This is a simple heuristic based on device file names */
+	if (strstr (device_file, "mouse") != NULL)
+		type |= GSD_DEVICE_TYPE_MOUSE;
+	else if (strstr (device_file, "keyboard") != NULL)
+		type |= GSD_DEVICE_TYPE_KEYBOARD;
+	else if (strstr (device_file, "touchscreen") != NULL)
+		type |= GSD_DEVICE_TYPE_TOUCHSCREEN;
+	else if (strstr (device_file, "touchpad") != NULL)
+		type |= GSD_DEVICE_TYPE_TOUCHPAD;
+	else if (strstr (device_file, "tablet") != NULL)
+		type |= GSD_DEVICE_TYPE_TABLET;
+	else
+		/* Default to generic input device */
+		type = GSD_DEVICE_TYPE_MOUSE;
 
 	return type;
 }
 
