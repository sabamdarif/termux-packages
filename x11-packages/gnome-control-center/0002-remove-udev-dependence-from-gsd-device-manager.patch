+	FILE *fp;
+	gchar *name_file;
+	gchar *name = NULL;
+	gchar buffer[256];
+
+	/* Try to read device name from sysfs if available */
+	name_file = g_strdup_printf ("/sys/class/input/%s/device/name", 
+	                            g_path_get_basename (device_file));
+	
+	fp = fopen (name_file, "r");
+	if (fp) {
+		if (fgets (buffer, sizeof (buffer), fp)) {
+			/* Remove trailing newline */
+			gchar *newline = strchr (buffer, '\n');
+			if (newline)
+				*newline = '\0';
+			name = g_strdup (buffer);
+		}
+		fclose (fp);
+	}
+	
+	g_free (name_file);
+	
+	/* Fallback to basename if we can't read the name */
+	if (!name)
+		name = g_strdup (g_path_get_basename (device_file));
+	
+	return name;
