From 687c6a5d64b7302c511b31cd3ac763b2890b47e6 Mon Sep 17 00:00:00 2001
From: Md Arif <111168803+sabamdarif@users.noreply.github.com>
Date: Fri, 25 Jul 2025 15:04:06 +0530
Subject: [PATCH] remove polkit form remote-desktop

---
 .../remote-desktop/cc-remote-login-page.c     | 23 ++++---------------
 panels/system/remote-desktop/meson.build      | 18 ---------------
 2 files changed, 5 insertions(+), 36 deletions(-)

diff --git a/panels/system/remote-desktop/cc-remote-login-page.c b/panels/system/remote-desktop/cc-remote-login-page.c
index 20ee7ec..fc6b114 100644
--- a/panels/system/remote-desktop/cc-remote-login-page.c
+++ b/panels/system/remote-desktop/cc-remote-login-page.c
@@ -705,23 +705,10 @@ cc_remote_login_page_init (CcRemoteLoginPage *self)
                            G_CALLBACK (on_remote_login_active_changed), self,
                            G_CONNECT_SWAPPED);
 
-  self->permission = (GPermission*) polkit_permission_new_sync (REMOTE_LOGIN_PERMISSION, NULL, self->cancellable, &error);
 
-  if (error != NULL)
-    {
-      g_warning ("Cannot create '%s' permission: %s", REMOTE_LOGIN_PERMISSION, error->message);
-      g_clear_error (&error);
-    }
-
-  sync_permissions (self);
-  g_signal_connect_swapped (self->permission, "notify::allowed",
-                            G_CALLBACK (sync_permissions),
-                            self);
-
-  g_object_bind_property (self->password_entry, "sensitive",
-                          self->generate_password_button_row, "sensitive",
-                          G_BINDING_SYNC_CREATE);
-  cc_permission_infobar_set_permission (self->permission_infobar, self->permission);
-
-  connect_to_remote_desktop_configuration_rdp_server (self);
+  self->permission = NULL;
+  g_object_bind_property(self->password_entry, "sensitive",
+                         self->generate_password_button_row, "sensitive",
+                         G_BINDING_SYNC_CREATE);
+  connect_to_remote_desktop_configuration_rdp_server(self);
 }
diff --git a/panels/system/remote-desktop/meson.build b/panels/system/remote-desktop/meson.build
index 16dfc40..30afebd 100644
--- a/panels/system/remote-desktop/meson.build
+++ b/panels/system/remote-desktop/meson.build
@@ -5,21 +5,3 @@ sources += gnome.gdbus_codegen(
   interface_prefix: 'org.gnome.',
   namespace: 'Gsd'
 )
-
-polkit_conf = configuration_data()
-polkit_conf.set('libexecdir', control_center_libexecdir)
-polkit = 'org.gnome.controlcenter.remote-session-helper.policy'
-
-polkit_in = configure_file(
-  input: polkit + '.in.in',
-  output: polkit + '.in',
-  configuration: polkit_conf
-)
-
-i18n.merge_file(
-  input: polkit_in,
-  output: polkit,
-  po_dir: po_dir,
-  install: true,
-  install_dir: join_paths(control_center_datadir, 'polkit-1', 'actions')
-)
-- 
2.48.1

